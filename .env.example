# ---------------------------------------------------------------------------
# Navigator default model config.
#
# These are BUILD-TIME defaults only (Vite inlines VITE_* into the bundle).
# Real keys belong in the extension's Settings tab, stored locally in IndexedDB
# via chrome.storage — never committed, never shipped in a build.
# ---------------------------------------------------------------------------

# OpenAI-compatible endpoint: DashScope, OpenRouter, or a local vLLM server.
VITE_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=qwen3-max

# Small/fast model used for classification, extraction and relevance scoring.
VITE_LLM_SMALL_MODEL=qwen3-8b

VITE_LLM_TEMPERATURE=0.2
VITE_LLM_MAX_TOKENS=4096
VITE_LLM_CONTEXT_WINDOW=131072
